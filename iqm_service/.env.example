# Copy this file to .env (never commit the real .env).
#
# iqm_service owns no database connection of any kind — backend/'s
# quantum_hw_jobs collection is the single source of truth for job records;
# this service is a stateless translator to the real IQM Resonance API. See
# PLANS/iqm-service.md.

# --- IQM Resonance credentials (iqm_client.py) — get this from your
# Resonance dashboard at resonance.meetiqm.com. Required for real hardware
# devices (garnet/emerald/sirius); the free `:mock` device variants work
# without it. ---
IQM_TOKEN=<your-iqm-resonance-token>

# --- Internal auth (main.py) — backend/'s IQM_SERVICE_URL/IQM_SERVICE_SECRET
# must point at this service and share this exact secret. ---
IQM_SERVICE_SECRET=<shared-random-secret-matching-backend/.env>

# Platform-injected port convention (Render/Railway/etc — see Dockerfile's
# CMD `--port ${PORT:-8082}`); leave unset to use 8082 locally. Convention in
# this repo: iqm_service is always 8082, the next free slot after
# qstudio_service's 8080 and notebook_service's 8081.
# PORT=8082
