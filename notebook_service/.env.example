# Copy this file to .env (never commit the real .env).
#
# notebook_service owns no database connection of any kind (no MongoDB, no
# Firebase) — it only verifies a signed session token and manages ephemeral
# ipykernel processes. See PLANS/qbook.md §0.

# --- Session token verification (auth.py) — backend/'s QBOOK_SERVICE_SECRET
# must be set to this exact same value; backend mints the token (HS256),
# this service only verifies it. ---
QBOOK_SERVICE_SECRET=<shared-random-secret-matching-backend/.env>

# --- Kernel pool limits (kernel_manager.py / main.py) — all optional,
# defaults shown below. ---
# One ipykernel process per (uid, notebook_id) — global ceiling across all users.
# QBOOK_MAX_KERNELS=20
# Per-user ceiling, independent of the global one above.
# QBOOK_MAX_KERNELS_PER_UID=3
# A kernel with no activity for this long is reaped.
# QBOOK_IDLE_TIMEOUT_SECONDS=1200
# A single cell execution running longer than this is interrupted.
# QBOOK_EXEC_TIMEOUT_SECONDS=30
# Per-kernel CPU time rlimit (resource.setrlimit), seconds.
# QBOOK_KERNEL_CPU_SECONDS=120
# Per-kernel process/thread count rlimit (RLIMIT_NPROC).
# QBOOK_KERNEL_NPROC_LIMIT=256
# Max size of a dataset attached via attach_dataset, bytes (default 10MB).
# QBOOK_DATASET_MAX_BYTES=10485760

# Platform-injected port convention (Render/Railway/etc — see Dockerfile's
# CMD `--port ${PORT:-8081}`); leave unset to use 8081 locally. Convention in
# this repo: notebook_service is always 8081, so it never collides with
# qstudio_service's 8080.
# PORT=8081
